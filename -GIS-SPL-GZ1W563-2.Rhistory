if (! inherits(obj1, "CellChat")) stop(paste(obj1.name, "is not a CellChat object."))
stopifnot("obj2 is not a CellPhoneDB list" = is.list(obj2))
crosscheck_CC_CPDB(obj1, obj2, threshold = threshold, return.all = return.all)
}
if(comp.type == "CellPhoneDB_to_CellChat") {
stopifnot("obj1 is not a CellPhoneDB list" = is.list(obj1))
stopifnot("obj2 is not a CellChat object"  = class(obj2) == "CellChat")
crosscheck_CC_CPDB(obj2, obj1, threshold = threshold, return.all = return.all)
}
if(comp.type == "CellChat_to_CellChat") {
stopifnot("obj1 is not a CellChat object"  = class(obj1) == "CellChat")
stopifnot("obj2 is not a CellChat object"  = class(obj2) == "CellChat")
crosscheck_CC_CC(obj1, obj2)
}
if(comp.type == "CellPhoneDB_to_CellPhoneDB") {
stopifnot("obj1 is not a CellPhoneDB list" = is.list(obj1))
stopifnot("obj2 is not a CellPhoneDB list" = is.list(obj2))
crosscheck_CPDB_CPDB(obj1, obj2)
}
}
crosscheck(diamonds, diamonds, comp.type = "CellChat_to_CellPhoneDB")
